# Copy to .env on the VPS (docker compose reads it). NEVER commit the real .env.
GOOGLE_AI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Residential / Nigeria proxy for Sofascore + SportyBet (datacenter IPs are blocked).
# Format: http://user:pass@host:port   (IPRoyal/Smartproxy/BrightData give you this)
SCRAPER_PROXY=http://user:pass@proxy-host:port
SCOPE=ahead
REFRESH_HOURS=12
# Only if using the caddy TLS profile:
DOMAIN=api.yourdomain.com
